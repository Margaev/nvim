#!/bin/sh
# Conform supplies the project Maven command followed by the plugin arguments.
maven=$1
shift

daemon=$(command -v mvnd) || daemon="${SDKMAN_CANDIDATES_DIR:-${SDKMAN_DIR:-$HOME/.sdkman}/candidates}/mvnd/current/bin/mvnd"
if [ -x "$daemon" ]; then
  "$daemon" "$@" && exit 0
fi

exec "$maven" "$@"
